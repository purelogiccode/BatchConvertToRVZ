<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RVZStudio.dialogs.MessageBoxWindow"
        Title="Message"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="620"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        ToolTip.Tip="Message dialog">
    <Grid Margin="20" RowDefinitions="Auto,Auto" ToolTip.Tip="Message dialog">
        <StackPanel Orientation="Horizontal" ToolTip.Tip="Message content">
            <TextBlock x:Name="IconText"
                       FontSize="28"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"
                       IsVisible="False"
                       ToolTip.Tip="Message icon" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       MaxWidth="500"
                       ToolTip.Tip="Message text" />
        </StackPanel>
        <StackPanel x:Name="ButtonsPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    ToolTip.Tip="Dialog buttons" />
    </Grid>
</Window>
