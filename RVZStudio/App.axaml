<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RVZStudio.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ==================== COLOR PALETTE ==================== -->
            <!--
                Harmonious Dark Theme with Green Terminal Accent
                Primary: Deep Slate (#1a1d21)
                Secondary: Teal/Cyan (#00bcd4) - complements the green terminal
                Accent: Soft Green (#4caf50) - harmonizes with terminal green
                Terminal: Black (#0a0a0a) + Neon Green (#39FF14) - PRESERVED
            -->

            <!-- ==================== TERMINAL COLORS ==================== -->
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0a0a0a" />
            <SolidColorBrush x:Key="TerminalBorderBrush" Color="#1a1a1a" />
            <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#ffffff" />
            <SolidColorBrush x:Key="TerminalSelectedBrush" Color="#2a2a2a" />

            <!-- ==================== WINDOW & BACKGROUND COLORS ==================== -->
            <!-- Deep Slate Theme Base -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121518" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1e2227" />
            <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#252a30" />
            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0d0f12" />

            <!-- ==================== BORDER COLORS ==================== -->
            <SolidColorBrush x:Key="BorderBrush" Color="#2d333b" />
            <SolidColorBrush x:Key="BorderBrushLight" Color="#3d454f" />

            <!-- ==================== TEXT COLORS ==================== -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#e6edf3" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8b949e" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6e7681" />
            <SolidColorBrush x:Key="HeaderTextBrush" Color="#ffffff" />

            <!-- Status Text Colors - Harmonious with theme -->
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#4caf50" />
            <SolidColorBrush x:Key="FailedTextBrush" Color="#f85149" />
            <SolidColorBrush x:Key="SkippedTextBrush" Color="#ffa726" />
            <SolidColorBrush x:Key="LinkTextBrush" Color="#58a6ff" />
            <SolidColorBrush x:Key="InfoTextBrush" Color="#00bcd4" />

            <!-- ==================== PRIMARY ACCENT COLORS ==================== -->
            <!-- Teal/Cyan as primary - complements the green terminal -->
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="#008ba3" />

            <!-- Secondary accent - Soft Green (harmonizes with terminal) -->
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="SecondaryAccentDarkBrush" Color="#008ba3" />

            <!-- ==================== BUTTON COLORS ==================== -->
            <!-- Action Button (Teal) -->
            <SolidColorBrush x:Key="ActionButtonBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="ActionButtonHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="ActionButtonPressedBrush" Color="#008ba3" />

            <!-- Start/Success Button (Green - harmonizes with terminal) -->
            <SolidColorBrush x:Key="StartButtonBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="StartButtonHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="StartButtonPressedBrush" Color="#008ba3" />

            <!-- Cancel/Error Button (Soft Red) -->
            <SolidColorBrush x:Key="CancelButtonBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="CancelButtonPressedBrush" Color="#008ba3" />

            <!-- About/Info Button (Purple - complementary to teal) -->
            <SolidColorBrush x:Key="AboutButtonBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="AboutButtonHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="AboutButtonPressedBrush" Color="#008ba3" />

            <!-- Exit Button (Slate Gray) -->
            <SolidColorBrush x:Key="ExitButtonBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="ExitButtonHoverBrush" Color="#00e5ff" />
            <SolidColorBrush x:Key="ExitButtonPressedBrush" Color="#008ba3" />

            <!-- Donate Button -->
            <SolidColorBrush x:Key="DonateButtonBrush" Color="#e53935" />
            <SolidColorBrush x:Key="DonateButtonHoverBrush" Color="#ef5350" />
            <SolidColorBrush x:Key="DonateButtonPressedBrush" Color="#b71c1c" />

            <!-- Disabled State -->
            <SolidColorBrush x:Key="DisabledButtonBrush" Color="#3d454f" />
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#6e7681" />

            <!-- ==================== NAVIGATION COLORS ==================== -->
            <SolidColorBrush x:Key="NavigationUnderlineBrush" Color="#00bcd4" />
            <SolidColorBrush x:Key="NavigationHoverBrush" Color="#1e2227" />

            <!-- ==================== STATUS BAR ==================== -->
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0d0f12" />

            <!-- ==================== PROGRESS BAR ==================== -->
            <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#2d333b" />
            <SolidColorBrush x:Key="ProgressForegroundBrush" Color="#00bcd4" />

            <!-- ==================== OVERLAY & EFFECTS ==================== -->
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#CC000000" />
            <Color x:Key="TerminalGlowColor">#ffffff</Color>

            <!-- ==================== BUTTON TEXT COLORS ==================== -->
            <SolidColorBrush x:Key="ButtonTextDarkBrush" Color="#000000" />

            <!-- ==================== NAMED THEMES ==================== -->

            <!-- Primary Action Button Theme -->
            <ControlTheme x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="15,0" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="Background" Value="{StaticResource ActionButtonBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource ActionButtonHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource ActionButtonPressedBrush}" />
                </Style>
                <Style Selector="^:disabled /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource DisabledButtonBrush}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
            </ControlTheme>

            <!-- Start Button Theme -->
            <ControlTheme x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource StartButtonBrush}" />
                <Style Selector="^:pointerover /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource StartButtonHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource StartButtonPressedBrush}" />
                </Style>
            </ControlTheme>

            <!-- Cancel Button Theme -->
            <ControlTheme x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource CancelButtonBrush}" />
                <Style Selector="^:pointerover /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource CancelButtonHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource CancelButtonPressedBrush}" />
                </Style>
            </ControlTheme>

            <!-- Donate Button Theme -->
            <ControlTheme x:Key="DonateButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DonateButtonBrush}" />
                <Style Selector="^:pointerover /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource DonateButtonHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#PART_Border">
                    <Setter Property="Background" Value="{StaticResource DonateButtonPressedBrush}" />
                </Style>
            </ControlTheme>

            <!-- GridSplitter Theme -->
            <ControlTheme x:Key="MainGridSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                <Setter Property="Cursor" Value="SizeWestEast" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                </Style>
            </ControlTheme>

            <!-- TabControl Theme -->
            <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <DockPanel>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            DockPanel.Dock="Top"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- TabItem Theme -->
            <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="15,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4,4,0,0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_LayoutRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Panel>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  RecognizesAccessKey="True" />
                                <Border Name="PART_SelectedPipe"
                                        Background="{StaticResource PrimaryAccentBrush}"
                                        Height="3"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,-1"
                                        IsVisible="False" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
                </Style>
            </ControlTheme>

            <!-- Expander Theme (card with arrow header, matching the WPF look) -->
            <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton Name="ExpanderHeader"
                                              DockPanel.Dock="Top"
                                              Tag="collapsed"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Cursor="Hand"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate>
                                            <Border Name="HeaderBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="10">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="PART_Arrow"
                                                   Text="▶"
                                                   FontSize="10"
                                                   Foreground="{StaticResource PrimaryAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{StaticResource HeaderTextBrush}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Border Name="ExpanderContent"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      VerticalAlignment="Top" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:expanded /template/ TextBlock#PART_Arrow">
                    <Setter Property="Text" Value="▼" />
                </Style>
                <Style Selector="^ /template/ ToggleButton#ExpanderHeader:pointerover">
                    <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
                </Style>
            </ControlTheme>

            <!-- CheckBox Theme -->
            <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <Border Name="Border"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="2"
                                    CornerRadius="3">
                                <Path Name="CheckMark"
                                      Width="10"
                                      Height="10"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 5 L 3 8 L 8 1"
                                      Stroke="{StaticResource PrimaryAccentBrush}"
                                      StrokeThickness="2"
                                      Stretch="Uniform"
                                      IsVisible="False" />
                            </Border>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Path#CheckMark">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:checked /template/ Border#Border">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#Border">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Style>
            </ControlTheme>

            <!-- RadioButton Theme -->
            <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Name="OuterEllipse"
                                         Fill="{StaticResource CardBackgroundBrush}"
                                         Stroke="{StaticResource BorderBrushLight}"
                                         StrokeThickness="2" />
                                <Ellipse Name="InnerEllipse"
                                         Width="8"
                                         Height="8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource PrimaryAccentBrush}"
                                         IsVisible="False" />
                            </Panel>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Ellipse#InnerEllipse">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
                    <Setter Property="Stroke" Value="{StaticResource PrimaryAccentBrush}" />
                </Style>
                <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
                    <Setter Property="Stroke" Value="{StaticResource PrimaryAccentBrush}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Style>
            </ControlTheme>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Default ToolTip Style -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Default TextBlock Style -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Default TextBox Style -->
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>

        <!-- Default ComboBox Style -->
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
        </Style>

        <!-- Default ComboBoxItem Style -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource HeaderTextBrush}" />
        </Style>

        <!-- Default ProgressBar Style -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource ProgressForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource ProgressBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <!-- Default DataGrid Style -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
        <Style Selector="DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBackgroundHoverBrush}" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
            <Setter Property="Foreground" Value="#121518" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
