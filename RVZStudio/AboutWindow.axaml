<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RVZStudio.AboutWindow"
        Title="About RVZStudio"
        Width="600"
        Height="780"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        ToolTip.Tip="About RVZStudio">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" ToolTip.Tip="Application information">

        <!-- Logo Section -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15" ToolTip.Tip="Application Logo">
            <StackPanel HorizontalAlignment="Center" ToolTip.Tip="Application Logo">
                <Image Width="120" Height="120" Source="avares://RVZStudio/images/logo.png" ToolTip.Tip="RVZStudio logo" />
            </StackPanel>
        </Border>

        <!-- Title & Version Section -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15" ToolTip.Tip="Application name and version">
            <StackPanel ToolTip.Tip="Application name and version">
                <TextBlock FontWeight="Bold" FontSize="20" Foreground="{StaticResource HeaderTextBrush}" Text="RVZStudio" HorizontalAlignment="Center" ToolTip.Tip="RVZStudio - batch converter for GameCube and Wii disc images" />
                <TextBlock Name="AppVersionTextBlock" Margin="0,8,0,0" Text="" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" FontSize="14" ToolTip.Tip="Application version" />
            </StackPanel>
        </Border>

        <!-- Description Section -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15" ToolTip.Tip="Brief overview of the application purpose">
            <StackPanel ToolTip.Tip="Application description and links">
                <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Text="Description" Margin="0,0,0,10" ToolTip.Tip="Application description" />
                <TextBlock TextWrapping="Wrap" Text="A cross-platform utility for batch converting GameCube and Wii disc images to RVZ format, with verification, extraction and a built-in disc explorer." Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" ToolTip.Tip="A cross-platform utility for batch converting GameCube and Wii disc images to RVZ format, with verification, extraction and a built-in disc explorer" />
                <TextBlock Margin="0,10,0,0" ToolTip.Tip="Project repository link">
                    <TextBlock Text="https://github.com/purelogiccode/RVZStudio"
                               Cursor="Hand"
                               Tag="https://github.com/purelogiccode/RVZStudio"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource LinkTextBrush}"
                               TextDecorations="Underline"
                               ToolTip.Tip="Visit the project repository" />
                </TextBlock>
                <TextBlock Margin="0,15,0,0" ToolTip.Tip="Official website link">
                    <TextBlock Text="https://www.purelogiccode.com"
                               Cursor="Hand"
                               Tag="https://www.purelogiccode.com"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource LinkTextBrush}"
                               TextDecorations="Underline"
                               ToolTip.Tip="Visit the official website" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Acknowledgements Section -->
        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15" ToolTip.Tip="Credits and third-party tools used">
            <StackPanel ToolTip.Tip="Credits and third-party tools used">
                <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Text="Acknowledgements" Margin="0,0,0,10" ToolTip.Tip="Credits and third-party tools used" />
                <WrapPanel Margin="0,0,0,8" ToolTip.Tip="RVZSharp credit">
                    <TextBlock Text="• Uses " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="RVZSharp credit" />
                    <TextBlock Text="RVZSharp" FontWeight="Bold" Cursor="Hand"
                               Tag="https://github.com/purelogiccode/RVZSharp"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open RVZSharp GitHub repository" />
                    <TextBlock Text=" as the primary engine for native RVZ encoding, decoding and verification." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="RVZSharp credit" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" ToolTip.Tip="Dolphin Emulator credit">
                    <TextBlock Text="• Uses " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Dolphin Emulator credit" />
                    <TextBlock Text="DolphinTool.exe" FontWeight="Bold" Cursor="Hand"
                               Tag="https://dolphin-emu.org/"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open Dolphin Emulator website" />
                    <TextBlock Text=" from the Dolphin Emulator project as a fallback for conversions, extraction and verification." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Dolphin Emulator credit" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" ToolTip.Tip="SharpCompress credit">
                    <TextBlock Text="• Uses " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="SharpCompress credit" />
                    <TextBlock Text="SharpCompress" FontWeight="Bold" Cursor="Hand"
                               Tag="https://github.com/adamhathcock/sharpcompress"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open SharpCompress GitHub repository" />
                    <TextBlock Text=" for .zip, .7z and .rar archive extraction." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="SharpCompress credit" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" ToolTip.Tip="7-Zip credit">
                    <TextBlock Text="• Bundles " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="7-Zip credit" />
                    <TextBlock Text="7-Zip (7za)" FontWeight="Bold" Cursor="Hand"
                               Tag="https://www.7-zip.org/"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open 7-Zip website" />
                    <TextBlock Text=" as a fallback when SharpCompress cannot extract an archive." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="7-Zip credit" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" ToolTip.Tip="Serilog credit">
                    <TextBlock Text="• Uses " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Serilog credit" />
                    <TextBlock Text="Serilog" FontWeight="Bold" Cursor="Hand"
                               Tag="https://serilog.net/"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open Serilog website" />
                    <TextBlock Text=" for structured logging with custom sinks." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Serilog credit" />
                </WrapPanel>
                <WrapPanel ToolTip.Tip="Development credit">
                    <TextBlock Text="• Created and maintained by " TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Development credit" />
                    <TextBlock Text="Pure Logic Code" FontWeight="Bold" Cursor="Hand"
                               Tag="https://www.purelogiccode.com"
                               PointerPressed="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               ToolTip.Tip="Open Pure Logic Code website" />
                    <TextBlock Text="." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip.Tip="Development credit" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Close Button Section -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" ToolTip.Tip="Close the About window">
            <Button Click="CloseButton_Click" Content="Close" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Close the About window" />
        </StackPanel>
    </Grid>
</Window>
